{
  "name": "aerosim-analytics",
  "private": true,
  "version": "0.1.0",
  "description": "AeroSim Analytics: Flight Mechanics II interactive suite (thin airfoil theory, static stability, longitudinal state-space dynamics, maneuvering flight).",
